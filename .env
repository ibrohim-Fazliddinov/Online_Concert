
# PostgresSQL database configuration
# DATABASE_DSN=postgresql://user:password@db-host:5432/dbname
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_HOST=0.0.0.0
POSTGRES_PORT=5434
POSTGRES_DB=postgres_db

